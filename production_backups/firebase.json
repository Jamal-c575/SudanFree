{
    "firestore": {
        "rules": "firebase/firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "storage": {
        "rules": "firebase/storage.rules"
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log",
                "*.local"
            ]
        }
    ],
    "hosting": {
        "site": "sudanfree-d04fc",
        "public": "sudan_free/build/web",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    },
    "emulators": {
        "singleProjectMode": false,
        "auth": {
            "port": 9099
        },
        "firestore": {
            "port": 8080
        },
        "functions": {
            "port": 5001
        },
        "ui": {
            "enabled": true,
            "port": 4000
        },
        "hub": {
            "port": 4400
        }
    }
}
