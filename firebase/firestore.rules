rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── Helper Functions ───────────────────────────────────────
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // ─── Data Validation Helpers ────────────────────────────────
    function isValidString(field, maxLen) {
      return field is string && field.size() <= maxLen;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }


    // ═══════════════════ المستخدمين (Users) ═══════════════════
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) &&
        hasRequiredFields(['name', 'role']) &&
        isValidString(request.resource.data.name, 100) &&
        isValidString(request.resource.data.role, 30) &&
        request.resource.data.role != 'admin';
      allow update: if isAuthenticated() && (
        // المالك يعدل بياناته — لا يمكنه تغيير الحقول المحمية
        (isOwner(userId) && (
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified', 'verificationStatus', 'verifiedAt', 'rating', 'reviewsCount', 'completedJobs', 'negativeReports', 'walletBalance', 'ratingCounts', 'profileViews', 'isPremium', 'subscriptionExpiry']))
          && (!('role' in request.resource.data) || request.resource.data.role != 'admin')
          ||
          // السماح بالتحقق الذاتي عبر رقم الهاتف
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isVerified', 'updatedAt']) && request.resource.data.isVerified == true && request.auth.token.phone_number != null)
        ))
        || 
        // مستخدمون آخرون يعدلون فقط حقول التفاعل بإجراءات محددة وصارمة
        (!isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'profileViews', 'dailyProfileViews', 'lastViewReset', 'viewers', 'pendingPartnerIds', 'partnerIds', 'followers', 'pendingApprenticeRequests', 'pendingMasterRequests', 'pendingLeaveRequests', 'apprenticesIds', 'masterId', 'vouchedBy', 'following', 'pendingSquadInvites', 'completedJobs']) &&
        // حماية الزيارات: الزيادة بمقدار 1 فقط
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['profileViews']) || request.resource.data.profileViews == resource.data.profileViews + 1) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dailyProfileViews']) || request.resource.data.dailyProfileViews == resource.data.dailyProfileViews + 1 || request.resource.data.dailyProfileViews == 1) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['completedJobs']) || request.resource.data.completedJobs == resource.data.completedJobs + 1))
        ||
        // المشرف يعدل أي شيء
        isAdmin()
      );
      allow delete: if isOwner(userId) || isAdmin();

      // عداد الزيارات الفريدة
      match /views/{visitorId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && request.auth.uid == visitorId;
      }
      
      // إعدادات المستخدم الشخصية
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // ═══ معرض الأعمال (Portfolio subcollection) ═══
      match /portfolio/{itemId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.auth.uid == userId;
        allow update, delete: if isOwner(userId) || isAdmin();
      }

      // ═══ تأييدات المهارات (Endorsements subcollection) ═══
      match /endorsements/{endorsementId} {
        allow read: if true;
        allow create: if isAuthenticated() && 
          request.auth.uid == request.resource.data.endorserId &&
          request.auth.uid != userId; // لا يمكن للمستخدم تأييد نفسه
        allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.endorserId || isAdmin());
      }
    }
    
    // ═══════════════════ المنشورات (Posts) ═══════════════════
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        isValidString(request.resource.data.caption, 5000);
      allow update: if isAuthenticated() && (
        isOwner(resource.data.userId) || 
        // السماح بتحديث حقول التفاعل فقط لغير المالك بشكل مقيد
        // ملاحظة: poll يتم تحديثه عبر voteInPoll في الكود — نسمح به هنا
        // isPinned محمي — فقط المالك يمكنه تثبيت منشوره
        // viewsCount يتم عبر transaction في الكود
        (!isOwner(resource.data.userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'commentsCount', 'likesCount', 'sharesCount', 'viewsCount', 'poll', 'updatedAt']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['commentsCount']) || (!('commentsCount' in resource.data) && request.resource.data.commentsCount == 1) || request.resource.data.commentsCount == resource.data.commentsCount + 1 || request.resource.data.commentsCount == resource.data.commentsCount - 1) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['viewsCount']) || (!('viewsCount' in resource.data) && request.resource.data.viewsCount == 1) || request.resource.data.viewsCount == resource.data.viewsCount + 1) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['sharesCount']) || (!('sharesCount' in resource.data) && request.resource.data.sharesCount == 1) || request.resource.data.sharesCount == resource.data.sharesCount + 1) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reactions']) || (!('reactions' in resource.data) && request.resource.data.reactions.keys().hasOnly([request.auth.uid])) || request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid]))) ||
        isAdmin()
      );
      allow delete: if isOwner(resource.data.userId) || isAdmin();

      // التعليقات كـ subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && 
          request.resource.data.userId == request.auth.uid &&
          isValidString(request.resource.data.content, 2000);
        allow update: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
        );
        allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      }
      
      // عداد الزيارات الفريدة للمنشور/المنتج
      match /views/{visitorId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && request.auth.uid == visitorId;
      }
    }

    // ═══════════════════ التعليقات — collectionGroup (للاستعلامات الشاملة) ═══════════════════
    match /{path=**}/comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        isValidString(request.resource.data.content, 2000);
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ═══════════════════ الرسائل — collectionGroup (للمشرف: استعلام العقود) ═══════════════════
    match /{path=**}/messages/{messageId} {
      allow read: if isAdmin();
    }
    
    // ═══════════════════ التقييمات (Reviews) ═══════════════════
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        request.resource.data.reviewerId == request.auth.uid &&
        request.resource.data.reviewerId != request.resource.data.freelancerId &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        (!('comment' in request.resource.data) || isValidString(request.resource.data.comment, 1000));
      allow update: if isOwner(resource.data.reviewerId);
      allow delete: if isOwner(resource.data.reviewerId) || isAdmin();
    }

    // ═══════════════════ حارس التقييم المكرر (Ratings Guard) ═══════════════════
    match /ratings/{ratingId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && 
        request.resource.data.reviewerId == request.auth.uid;
    }


    // ═══════════════════ الوظائف (Jobs) ═══════════════════
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.clientId) &&
        isValidString(request.resource.data.title, 200) &&
        isValidString(request.resource.data.description, 5000);
      allow update: if isAuthenticated() && (
         isOwner(resource.data.clientId) ||
         // Freelancer المعيّن يمكنه تحديث المراحل فقط
         (request.auth.uid == resource.data.assignedFreelancerId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['milestones', 'updatedAt'])) ||
         // أي مستخدم مصادق يضيف عرض → فقط عداد العروض بشكل مقيد
         (!isOwner(resource.data.clientId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proposalsCount', 'updatedAt']) &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['proposalsCount']) || request.resource.data.proposalsCount == resource.data.proposalsCount + 1 || request.resource.data.proposalsCount == resource.data.proposalsCount - 1)) ||
         isAdmin()
      );
      allow delete: if isOwner(resource.data.clientId) || isAdmin();
    }

    // ═══════════════════ العروض (Proposals) ═══════════════════
    match /proposals/{proposalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        request.resource.data.freelancerId == request.auth.uid &&
        isValidString(request.resource.data.coverLetter, 2000);
      allow update: if isAuthenticated() && (
        resource.data.freelancerId == request.auth.uid ||
        // صاحب الوظيفة يمكنه تغيير الحالة فقط
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      );
      allow delete: if isOwner(resource.data.freelancerId);
    }

    // ═══════════════════ العروض — collectionGroup ═══════════════════
    match /{path=**}/proposals/{proposalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        request.resource.data.freelancerId == request.auth.uid &&
        isValidString(request.resource.data.coverLetter, 2000);
      allow update: if isAuthenticated() && (
        resource.data.freelancerId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      );
      allow delete: if isOwner(resource.data.freelancerId);
    }

    // ═══════════════════ المجموعات (Squads) ═══════════════════
    match /squads/{squadId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        request.resource.data.leaderId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isOwner(resource.data.leaderId) || 
        // أعضاء الفريق وأي مستخدم يمكنهم الانضمام/المغادرة فقط، التقييم يتم عبر Cloud Functions
        (!isOwner(resource.data.leaderId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt']) &&
        // التحقق من إضافة أو إزالة المستخدم لنفسه فقط
        (!('memberIds' in request.resource.data) || (
           (request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 && request.resource.data.memberIds.hasAll(resource.data.memberIds) && request.auth.uid in request.resource.data.memberIds) ||
           (request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1 && resource.data.memberIds.hasAll(request.resource.data.memberIds) && !(request.auth.uid in request.resource.data.memberIds))
        ))) ||
        isAdmin()
      );
      allow delete: if isOwner(resource.data.leaderId) || isAdmin();
    }
    
    // ═══════════════════ المحادثات (Chats) ═══════════════════
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isAuthenticated() && 
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2; 
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants && 
          request.resource.data.senderId == request.auth.uid &&
          // منع الرسائل الطويلة جداً
          (
            !('content' in request.resource.data) || 
            request.resource.data.content.size() <= 5000
          );
        allow update: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contractStatus', 'contractDetails', 'contractPrice', 'cancelRequesterId', 'jobId', 'isRead']) ||
          (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'isEdited']))
        );
        allow delete: if isAuthenticated() && (
          resource.data.senderId == request.auth.uid ||
          isAdmin()
        );
      }
    }
    
    // ═══════════════════ الإشعارات (Notifications) ═══════════════════
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // أي مستخدم مسجل يمكنه إنشاء إشعار — مع تحديد الحجم
      allow create: if isAuthenticated() && 
        isValidString(request.resource.data.title, 200) &&
        isValidString(request.resource.data.message, 500); 
      allow update: if isOwner(resource.data.userId) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // ═══════════════════ البلاغات (Reports) ═══════════════════
    match /reports/{reportId} {
      allow create: if isAuthenticated() && 
        request.resource.data.reporterId == request.auth.uid &&
        isValidString(request.resource.data.reason, 2000);
      allow read: if isAuthenticated() && (isOwner(resource.data.reporterId) || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ═══════════════════ سجل إشعارات المشرف ═══════════════════
    match /admin_notifications_log/{logId} {
      allow read, write: if isAdmin();
    }
    
    // ═══════════════════ المدفوعات (Payments) ═══════════════════
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.clientId == request.auth.uid || resource.data.freelancerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.clientId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.clientId == request.auth.uid || resource.data.freelancerId == request.auth.uid);
    }
    
    // ═══════════════════ الطلبات (Requests) ═══════════════════
    match /requests/{requestId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        request.resource.data.clientId == request.auth.uid &&
        isValidString(request.resource.data.text, 5000) &&
        // Limit images to max 3
        (!('imageUrls' in request.resource.data) || request.resource.data.imageUrls.size() <= 3);
      allow update: if isAuthenticated() && (
        isOwner(resource.data.clientId) || 
        // السماح بتحديث عداد العروض فقط لغير المالك
        (!isOwner(resource.data.clientId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offersCount', 'updatedAt'])) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (isOwner(resource.data.clientId) || isAdmin());
      
      // العروض المقدمة على الطلب
      match /offers/{offerId} {
        allow read: if isAuthenticated() && (
          resource.data.providerId == request.auth.uid || 
          get(/databases/$(database)/documents/requests/$(requestId)).data.clientId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isAuthenticated() && request.resource.data.providerId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (resource.data.providerId == request.auth.uid || isAdmin());
      }
    }
    
    // ═══════════════════ إعدادات التطبيق (App Config) ═══════════════════
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ═══════════════════ الإعدادات العامة (Settings) ═══════════════════
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ═══════════════════ الأجهزة المحظورة ═══════════════════
    match /banned_devices/{deviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ═══════════════════ سجلات التواصل (Contact Logs) ═══════════════════
    match /contactLogs/{logId} {
      allow read: if isAuthenticated() && (
        resource.data.contacterId == request.auth.uid || 
        resource.data.freelancerId == request.auth.uid
      );
      allow create: if isAuthenticated() && 
        request.resource.data.contacterId == request.auth.uid;
      allow update: if isAuthenticated() && 
        resource.data.contacterId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasReviewed', 'reviewedAt']);
    }
    
    // ═══════════════════ سجلات التواصل (اسم بديل) ═══════════════════
    match /contact_logs/{logId} {
      allow read: if isAuthenticated() && (
        resource.data.contacterId == request.auth.uid || 
        resource.data.freelancerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && 
        request.resource.data.contacterId == request.auth.uid;
    }

    // ═══════════════════ طلبات الحذف ═══════════════════
    match /deletion_requests/{requestId} {
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow update, delete: if isAdmin();
    }

    // ═══════════════════ طلبات التوثيق (Verification Requests) ═══════════════════
    match /verification_requests/{requestId} {
      allow read: if isAuthenticated() && (
        (request.auth.uid == resource.data.userId) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId &&
        request.resource.data.status == 'pending' &&
        request.resource.data.submittedData is map &&
        request.resource.data.createdAt is timestamp;
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt']) &&
        request.resource.data.status in ['approved', 'rejected'] &&
        request.resource.data.reviewedAt is timestamp;
      allow delete: if isAdmin();
    }

    // ═══════════════════ معرض الأعمال (Portfolio — top-level legacy) ═══════════════════
    match /portfolio/{itemId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ═══════════════════ القصص (Stories) ═══════════════════
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // السماح للمالك بالحذف + أي مستخدم مصادق يمكنه إضافة نفسه كمشاهد
      allow update: if isAuthenticated() && (
        isOwner(resource.data.userId) || 
        // السماح لأي مستخدم بتسجيل نفسه كمشاهد فقط
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers'])
      );
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ═══════════════════ سجل الأخطاء (System Errors) ═══════════════════
    match /system_errors/{errorId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
    }

    // ═══════════════════ الإعلانات (Ads) ═══════════════════
    match /ads/{adId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || 
        (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['impressions', 'clicks']));
    }

    // ═══════════════════ الترويجات (Promotions) ═══════════════════
    match /promotions/{promoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ═══════════════════ فرق العمل (Squads — duplicate removed, unified above) ═══════════════════
    // (Covered in the squads section above)
    // ═══════════════════ إعدادات الإدارة (Admin Settings) ═══════════════════
    match /admin_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══════════════════ الاشتراكات (Subscriptions) ═══════════════════
    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // AI Suggestions (if any)
    match /ai_suggestions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══════════════════ التوثيق (Verifications) ═══════════════════
    match /verification_requests/{requestId} {
      allow read, write: if isAdmin();
    }
    match /otp_codes/{otpId} {
      allow read, write: if isAdmin();
    }
    match /reports/{reportId} {
      allow read, write: if isAdmin();
    }
    match /deletion_requests/{reqId} {
      allow read, write: if isAdmin();
    }
    match /jobs/{jobId} {
      allow read, write: if isAdmin();
    }
    match /requests/{reqId} {
      allow read, write: if isAdmin();
    }
    match /notifications/{notifId} {
      allow read, write: if isAdmin();
    }
    match /admin_settings/{settingId} {
      allow read, write: if isAdmin();
    }
    match /ads/{adId} {
      allow read, write: if isAdmin();
    }
    // match /app_config and match /settings duplicates removed
    match /bulk_notifications/{notifId} {
      allow read, write: if isAdmin();
    }
    match /system_settings/{settingId} {
      allow read, write: if isAdmin();
    }
    match /promotions/{promoId} {
      allow read, write: if isAdmin();
    }
    match /subscriptions/{subId} {
      allow read, write: if isAdmin();
    }
    match /success_stories/{storyId} {
      allow read, write: if isAdmin();
    }

    // ═══════════════════ JHOME ═══════════════════
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /successStories/{storyId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /storySubmissions/{subId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /enrollmentRequests/{reqId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /course_requests/{reqId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /courses_credentials/{credId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /pageContent/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /media_library/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /active_sessions/{sessionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /archived_sessions/{sessionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /course_chats/{chatId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /bank_accounts/{accountId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /lessonResources/{resId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /curriculum/{currId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /curriculumLessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══════════════════ التقييمات والعقود (Ratings, Reviews & Contracts) ═══════════════════
    match /ratings/{ratingId} {
      allow read: if true;
      // Authenticated users can create ratings for themselves as reviewers
      allow create: if isAuthenticated() && request.resource.data.reviewerId == request.auth.uid;
      // Ratings cannot be updated or deleted by users, only admins
      allow update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /contract_relations/{relationId} {
      allow read: if isAuthenticated() && relationId.matches('.*' + request.auth.uid + '.*');
      // They can create/update it if they are one of the parties.
      allow create, update: if isAuthenticated() && relationId.matches('.*' + request.auth.uid + '.*');
      allow delete: if isAdmin();
    }
  }
}
